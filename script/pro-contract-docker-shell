#!/bin/sh
set -eu

docker=${OPENCODE_DOCKER_EXECUTABLE:-docker}
container=${OPENCODE_DOCKER_CONTAINER:?set OPENCODE_DOCKER_CONTAINER}
host_root=${OPENCODE_DOCKER_HOST_ROOT:?set OPENCODE_DOCKER_HOST_ROOT}
container_root=${OPENCODE_DOCKER_CONTAINER_ROOT:-/workspace}
hard_timeout=${OPENCODE_DOCKER_HARD_TIMEOUT_SECONDS:-600}

case "$hard_timeout" in
  "" | *[!0-9]*) echo "Invalid hard timeout: $hard_timeout" >&2; exit 2 ;;
esac
if [ "$hard_timeout" -lt 1 ]; then
  echo "Hard timeout must be positive" >&2
  exit 2
fi

host_root=${host_root%/}
container_root=${container_root%/}
case "$PWD" in
  "$host_root") workdir=$container_root ;;
  "$host_root"/*) workdir="$container_root/${PWD#"$host_root"/}" ;;
  *) echo "Docker shell workdir escapes the workspace: $PWD" >&2; exit 126 ;;
esac

execution_id="oc-$$-$(date +%s)-${RANDOM:-0}"

signal_execution() {
  signal=$1
  "$docker" exec "$container" /bin/sh -c '
    id=$1
    signal=$2
    for proc in /proc/[0-9]*; do
      pid=${proc##*/}
      [ "$pid" = 1 ] && continue
      [ -r "$proc/environ" ] || continue
      tr "\000" "\n" <"$proc/environ" 2>/dev/null |
        grep -Fxq "OPENCODE_EXEC_ID=$id" || continue
      kill "-$signal" "$pid" 2>/dev/null || true
    done
  ' sh "$execution_id" "$signal" >/dev/null 2>&1 || true
}

cleanup() {
  signal_execution TERM
  sleep 0.2
  signal_execution KILL
}

interrupted() {
  trap - EXIT HUP INT TERM
  cleanup
  exit 143
}

trap interrupted HUP INT TERM
trap cleanup EXIT

set +e
"$docker" exec -i \
  --workdir "$workdir" \
  -e "OPENCODE_EXEC_ID=$execution_id" \
  "$container" \
  timeout -k 2 "$hard_timeout" /bin/sh "$@" &
client=$!
wait "$client"
result=$?
set -e

trap - EXIT HUP INT TERM
cleanup
exit "$result"
